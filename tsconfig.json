{
	"compilerOptions": {
		"target": "ES2020",
		"module": "CommonJS",
		"moduleResolution": "bundler",

		"outDir": "./dist/",
		"declaration": true,
		"sourceMap": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ES2020"]
	},
	"include": ["credentials/**/*", "nodes/**/*", "constants.ts"],
	"exclude": ["node_modules", "dist"]
}
